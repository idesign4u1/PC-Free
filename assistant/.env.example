# ─────────────────────────────────────────────────────────────────────────────
# Shay AI Assistant — environment configuration
#
# Copy to .env and fill in. Nothing here belongs in git: .env is gitignored.
# The app boots with whatever is set and reports the rest at /health, so you
# can bring integrations online one at a time.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TIMEZONE=Asia/Jerusalem

# Public HTTPS base URL. Meta and both OAuth providers redirect here, so in
# local development this must be your tunnel URL (e.g. https://xxxx.ngrok-free.app),
# not http://localhost:3000.
APP_URL=https://your-domain.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Local docker compose: postgres://assistant:assistant@localhost:5432/assistant
# Supabase: use the *session pooler* connection string and set DATABASE_SSL=true
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant
DATABASE_SSL=false

# ── Secrets at rest ──────────────────────────────────────────────────────────
# AES-256-GCM key protecting stored OAuth tokens. Exactly 32 bytes.
#   openssl rand -base64 32
# Changing this makes every stored token unreadable and forces a reconnect.
ENCRYPTION_KEY=

# ── Meta WhatsApp Business Platform (Cloud API) ──────────────────────────────
# See docs/META_SETUP.md for exactly where each value comes from.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# You invent this string; paste the same value into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=
# Approved Utility template used for reminders that fire more than 24 hours
# after your last message. Leave empty until the template is approved: without
# it, out-of-window reminders are deferred rather than sent.
WHATSAPP_TEMPLATE_REMINDER_NAME=
WHATSAPP_TEMPLATE_LOCALE=he
# Local development only. Never set this in production — it disables webhook
# signature verification and lets anyone post fake messages.
WHATSAPP_ALLOW_UNVERIFIED_WEBHOOK=false

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai             # openai | anthropic
# OpenAI: an sk-... key from https://platform.openai.com/api-keys
AI_API_KEY=

# Leave blank to use the current default for the provider
# (openai -> gpt-5.6-terra, anthropic -> claude-opus-5).
# Other OpenAI ids, cheapest to strongest: gpt-5.6-luna, gpt-5.6-terra,
# gpt-5.6-sol, gpt-6-astra. Confirm the one you pick actually answers with:
#   curl -s localhost:3000/api/ai-check -H "authorization: Bearer $ADMIN_TOKEN"
AI_MODEL=

# Intent parsing is a short classification on a latency-sensitive path, and the
# deterministic rules already handle the common phrasings without a model.
# Mapped to OpenAI's reasoning_effort (xhigh/max both become 'high').
AI_EFFORT=low                  # low | medium | high | xhigh | max
AI_MAX_TOKENS=4096
AI_TIMEOUT_MS=45000
# Only for an OpenAI-compatible gateway or a proxy. Leave blank for OpenAI itself.
AI_BASE_URL=

# ── Speech to text (WhatsApp voice notes) ────────────────────────────────────
# 'auto' turns transcription on whenever an OpenAI key is available — the same
# key serves both chat and audio, so with AI_PROVIDER=openai there is nothing
# else to set. Use 'none' to disable voice notes.
STT_PROVIDER=auto              # auto | openai | none
# Only needed to transcribe with a different account than AI_API_KEY.
STT_API_KEY=
STT_MODEL=gpt-4o-transcribe    # or gpt-4o-mini-transcribe (cheaper), whisper-1 (legacy)
STT_LANGUAGE=he

# ── Google (Calendar + Gmail) ────────────────────────────────────────────────
# docs/GOOGLE_SETUP.md. Redirect URI = APP_URL + GOOGLE_REDIRECT_PATH
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/oauth/google/callback

# ── Microsoft (Outlook Calendar + Mail) ──────────────────────────────────────
# docs/MICROSOFT_SETUP.md. Redirect URI = APP_URL + MICROSOFT_REDIRECT_PATH
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_PATH=/oauth/microsoft/callback

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=30000
REMINDER_BATCH_SIZE=25

# ── Admin surface ────────────────────────────────────────────────────────────
# Required in production: guards /admin, /health/full and the REST API.
#   openssl rand -hex 24
ADMIN_TOKEN=

# ── First-run user ───────────────────────────────────────────────────────────
# Registers you on first boot. The phone number is the one that will message
# the assistant, in E.164 digits with no '+' (e.g. 972501234567).
BOOTSTRAP_USER_NAME=Shay
BOOTSTRAP_USER_PHONE=
BOOTSTRAP_USER_EMAIL=
