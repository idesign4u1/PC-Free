{
  "name": "shay-ai-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "AI Personal Assistant for WhatsApp - tasks, calendars and email action items over an official WhatsApp Cloud API interface",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/db/cli-migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.12.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.6",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
