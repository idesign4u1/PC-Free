# ---------------------------------------------------------------------------
# algotrader environment. Copy to .env and fill in. NEVER commit the real file.
# ---------------------------------------------------------------------------

# --- Tradier PAPER (sandbox) credentials: required -------------------------
# Create a sandbox account and API token at https://dash.tradier.com
TRADIER_PAPER_TOKEN=your-sandbox-access-token
TRADIER_PAPER_ACCOUNT_ID=VA00000000

# --- Tradier LIVE credentials: leave EMPTY until the live gate passes -------
# These are ignored unless system.mode is LIVE_MODE, live_gate.enabled is true
# AND ENABLE_LIVE_TRADING=true below.
TRADIER_LIVE_TOKEN=
TRADIER_LIVE_ACCOUNT_ID=

# --- The live-money switch. Keep false. -------------------------------------
ENABLE_LIVE_TRADING=false

# --- Infrastructure ---------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://algotrader:algotrader@localhost:5432/algotrader
# For a quick local run without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./algotrader.sqlite
REDIS_URL=redis://localhost:6379/0
CONFIG_PATH=config/config.yaml

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Required for every state-changing endpoint. Without it, mutations are disabled.
API_TOKEN=generate-a-long-random-string
LOG_LEVEL=INFO
LOG_JSON=true

# --- Optional alerting ------------------------------------------------------
ALERT_WEBHOOK_URL=

# --- docker-compose only ----------------------------------------------------
POSTGRES_PASSWORD=algotrader
